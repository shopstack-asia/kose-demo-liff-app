# Server Configuration
PORT=4200
NODE_ENV=development

# CS LIFF App Code (used to fetch setting from CS API)
CS_LIFF_APP_CODE=MOCK

# Backend API Configuration (for future CS API integration)
# CS_API_BASE_URL=http://localhost:3000/api/v1
# CS_API_KEY=your_api_key_here

# Optional: Image Upload Configuration
# IMAGE_UPLOAD_PROVIDER=local
# IMAGE_UPLOAD_PATH=/uploads

# Optional: Analytics & Monitoring
# NEXT_PUBLIC_GA_ID=your_google_analytics_id
# SENTRY_DSN=your_sentry_dsn

